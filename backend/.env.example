# Variables de entorno del backend — copiar a Railway (produccion) o a
# backend/application-local.properties (desarrollo local, gitignored).

# Base de datos (Supabase - Session Pooler)
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.TU-PROJECT-ID
DB_PASSWORD=tu-password-de-supabase

# JWT (generar una clave larga y random para produccion)
JWT_SECRET=clave-secreta-larga-y-aleatoria

# Supabase Storage (para subida de fotos)
SUPABASE_URL=https://TU-PROJECT-ID.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key

# Admin inicial
ADMIN_EMAIL=admin@mihotel.com
ADMIN_PASSWORD=cambiar-en-produccion

# Email SMTP (opcional — sin esto los emails se loguean en consola)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail
MAIL_FROM=noreply@mihotel.com

# URL publica del frontend (para links en emails)
FRONTEND_URL=https://tu-app.vercel.app

# Puerto (Railway lo inyecta solo, no hace falta setearlo)
# PORT=8080
